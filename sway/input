input * {
	xkb_layout cz,cz(coder)
    xkb_options grp:shifts_toggle,compose:ins
}

input type:keyboard xkb_numlock enabled

input type:pointer {
  accel_profile adaptive
  pointer_accel 1
  natural_scroll disabled
  scroll_factor 1.0
  left_handed disabled
  middle_emulation disabled
}

input type:touchpad {
  events enabled
  accel_profile adaptive
  pointer_accel 0.0
  natural_scroll disabled
  scroll_factor 1.0
  scroll_method two_finger
  left_handed disabled
  tap enabled
  tap_button_map lrm
  drag enabled
  drag_lock disabled
  dwt enabled
  dwtp enabled
  middle_emulation enabled
  click_method button_areas
}
